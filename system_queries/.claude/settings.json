{
  "permissions": {
    "allow": [
      "Bash(sudo *)",
      "Bash(sensors*)",
      "Bash(nvidia-smi*)"
    ],
    "deny": [
      "Bash(sudo dd *)",
      "Bash(sudo mkfs*)",
      "Bash(sudo parted *)",
      "Bash(sudo fdisk *)",
      "Bash(sudo gdisk *)",
      "Bash(sudo shred *)",
      "Bash(sudo wipefs *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          { "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/load-machine-context.py" }
        ]
      }
    ]
  }
}
