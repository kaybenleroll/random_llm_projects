{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acs",
    "findings",
    "unrequested_scope",
    "test_adequacy",
    "assessable_fraction",
    "grade",
    "grade_rationale"
  ],
  "properties": {
    "acs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "partial",
              "not_met",
              "not_assessable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "file",
          "line",
          "title",
          "description",
          "evidence",
          "verifiable_by_inspection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "verifiable_by_inspection": {
            "type": "boolean"
          }
        }
      }
    },
    "unrequested_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "description",
          "significance"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "significance": {
            "type": "string",
            "enum": [
              "minor",
              "significant"
            ]
          }
        }
      }
    },
    "test_adequacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "rationale"
      ],
      "properties": {
        "rating": {
          "type": "string",
          "enum": [
            "adequate",
            "partial",
            "inadequate"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "grade_rationale": {
      "type": "string",
      "minLength": 1
    },
    "assessable_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
